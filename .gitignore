# Bí mật - không bao giờ commit
.env
.env.*
!.env.example

# Chứng chỉ TLS sinh tại chỗ
nginx/certs/*.key
nginx/certs/*.crt
nginx/certs/*.pem
!nginx/certs/.gitkeep

# File cấu hình sinh tại chỗ (chứa mật khẩu exporter)
mysqld-exporter/.my.cnf

# Dữ liệu backup
backups/
*.dump
*.sql.gz

# Log
*.log
nginx_logs/

# Hệ điều hành / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
