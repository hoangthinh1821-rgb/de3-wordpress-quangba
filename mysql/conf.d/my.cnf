[mysqld]
character-set-server        = utf8mb4
collation-server            = utf8mb4_unicode_ci
max_connections             = 100

# Bat log truy van cham de phan tich hieu nang bang LogQL
slow_query_log              = 1
slow_query_log_file         = /var/log/mysql/slow.log
long_query_time             = 2

# Giam thong tin lo ra log loi
log_error_verbosity         = 2

# Khong phan giai nguoc ten mien (tang toc ket noi)
skip-name-resolve

# Gioi han tai nguyen
table_open_cache            = 400
innodb_buffer_pool_size     = 256M
innodb_log_file_size        = 64M

[client]
default-character-set       = utf8mb4
